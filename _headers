  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://*.valuecommerce.com https://*.valuecommerce.ne.jp; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: https://*.valuecommerce.com https://*.valuecommerce.ne.jp; connect-src 'self' https://*.valuecommerce.com https://*.valuecommerce.ne.jp; frame-ancestors 'none'; base-uri 'self'; form-action 'none'; object-src 'none'

/events.json
  Cache-Control: no-cache
